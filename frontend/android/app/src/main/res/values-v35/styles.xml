<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: keep system bars outside the WebView (targetSdk 35 honours this opt-out) so the
         layout never sits under the status/navigation bars and adjustResize keeps working for the keyboard.
         capacitor.config "adjustMarginsForEdgeToEdge": "auto" reads this flag and adds no extra margins. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/nv_night</item>
        <item name="android:statusBarColor">@color/nv_night</item>
        <item name="android:navigationBarColor">@color/nv_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
